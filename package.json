{
  "name": "effector-storage",
  "description": "Module for Effector to sync stores with different storages",
  "version": "8.0.0",
  "author": "Victor Didenko <yumaa.verdin@gmail.com> (https://yumaa.name)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yumauri/effector-storage.git"
  },
  "bugs": {
    "url": "https://github.com/yumauri/effector-storage/issues"
  },
  "homepage": "https://github.com/yumauri/effector-storage#readme",
  "keywords": [
    "effector",
    "persist",
    "storage",
    "localstorage",
    "local storage",
    "sessionstorage",
    "session storage"
  ],
  "scripts": {
    "build": "NODE_ENV=production rollup --config",
    "build:dev": "rollup --config",
    "check:types": "tsc --noEmit",
    "check:biome": "biome check",
    "lint": "pnpm run /^check:/",
    "publint": "publint --level warning build",
    "format": "biome format --verbose --write .",
    "test": "pnpm run check:types && vitest run --coverage",
    "test-try": "node -e \"console.log('Installed effector version:', require('effector').version)\" && pnpm run check:types && vitest run",
    "e2e": "playwright test",
    "e2e:server": "vite build -c e2e/empty-app/vite.config.mts && vite preview -c e2e/empty-app/vite.config.mts",
    "doc:update-readme": "pnpm dlx doctoc --maxlevel 3 README.md",
    "clean": "rm -rf build coverage",
    "size": "size-limit --highlight-less"
  },
  "dependencies": {
    "@farfetched/core": "^0.15.0",
    "effector": "23.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-block-scoping": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.13",
    "@farfetched/superstruct": "^0.15.0",
    "@playwright/test": "^1.63.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@typescript/typescript6": "^6.0.2",
    "@types/node": "^24.13.4",
    "@vitest/coverage-v8": "5.0.0",
    "arktype": "^2.2.3",
    "esbuild": "^0.28.2",
    "patronum": "^2.3.0",
    "publint": "^0.3.24",
    "rollup": "^4.63.1",
    "rollup-plugin-command": "^1.1.3",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-generate-package-json": "^3.2.0",
    "size-limit": "^12.1.0",
    "superstruct": "^1.0.4",
    "typescript": "^7.0.2",
    "valibot": "^1.5.0",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "packageManager": "pnpm@11.26.0"
}
